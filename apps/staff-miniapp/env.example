# Staff Mini App env
#
# NEXT_PUBLIC_API_URL — backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8008

# NEXT_PUBLIC_BOT_SLUG — optional fallback. Bot slug is resolved from
# `?bot=<slug>` query or Telegram's `start_param` first. In production set
# the Mini App URL in @BotFather as:
#   https://<deployment>.vercel.app/?bot=<slug>
NEXT_PUBLIC_BOT_SLUG=
