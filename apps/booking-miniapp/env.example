# Booking Mini App env
#
# NEXT_PUBLIC_API_URL — booking-backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8008

# NEXT_PUBLIC_BOT_SLUG — optional. The Mini App resolves the bot slug from
# the URL (`?bot=<slug>`) or Telegram's `start_param` first; this env is a
# legacy single-bot fallback only. In production with many bots, leave it
# unset and instead set the Mini App URL in @BotFather to:
#   https://<your-deployment>.vercel.app/?bot=<slug>
NEXT_PUBLIC_BOT_SLUG=
